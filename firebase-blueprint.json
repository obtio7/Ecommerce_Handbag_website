{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A luxury handbag in the inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the handbag" },
        "description": { "type": "string", "description": "Detailed description of the bag" },
        "price": { "type": "number", "description": "Price in USD" },
        "category": { "type": "string", "description": "Bag category e.g. Tote, Clutch" },
        "imageUrl": { "type": "string", "description": "URL to the product image" },
        "stock": { "type": "number", "description": "Current quantity in stock" },
        "featured": { "type": "boolean", "description": "Whether to show on home page" }
      },
      "required": ["name", "price", "imageUrl", "stock"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a product",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "The ID of the bag being reviewed" },
        "userId": { "type": "string", "description": "The ID of the user who wrote the review" },
        "userName": { "type": "string", "description": "DisplayName or name of the reviewer" },
        "rating": { "type": "number", "description": "Rating from 1 to 5" },
        "comment": { "type": "string", "description": "The review text content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Review submission time" }
      },
      "required": ["productId", "rating", "comment", "userName"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "A product saved to a user's wishlist",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The owner of the wishlist" },
        "productId": { "type": "string", "description": "The ID of the bag" }
      },
      "required": ["userId", "productId"]
    },
    "Order": {
      "title": "Order",
      "description": "A completed purchase transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user (or 'guest' for guest checkout)" },
        "customerEmail": { "type": "string", "description": "Contact email for the order" },
        "items": { "type": "array", "description": "List of products and quantities" },
        "totalAmount": { "type": "number", "description": "Total price paid" },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered"], "description": "Current fulfillment status" },
        "shippingAddress": { "type": "object", "description": "Object containing address details" },
        "paymentId": { "type": "string", "description": "Reference for the payment transaction" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Order placement time" }
      },
      "required": ["customerEmail", "items", "totalAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Public catalog of all handbags"
    },
    "/products/{productId}/reviews": {
      "schema": "Review",
      "description": "Customer reviews for a specific product"
    },
    "/wishlists/{userId}/items": {
      "schema": "WishlistItem",
      "description": "Private user wishlists"
    },
    "/orders": {
      "schema": "Order",
      "description": "Transaction records (Securely restricted to admins or owners)"
    }
  }
}

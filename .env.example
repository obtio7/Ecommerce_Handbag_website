# ===========================================
# Zarevielle Web Application - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to git!

# -------------------------------------------
# MongoDB
# -------------------------------------------
# Connection string for the MongoDB database.
# For local development: mongodb://localhost:27017/zarevielle
# For production: use your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/zarevielle

# -------------------------------------------
# Server
# -------------------------------------------
# Port used by your server in production, e.g. 3000
PORT=3000

# -------------------------------------------
# Razorpay Payment Gateway (Server-side)
# -------------------------------------------
# Your Razorpay Key ID (starts with rzp_test_ for test mode or rzp_live_ for production).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Your Razorpay Key Secret (found in Razorpay Dashboard > Settings > API Keys).
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Webhook secret for verifying Razorpay webhook signatures.
# Set this in Razorpay Dashboard > Settings > Webhooks when configuring the webhook URL.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# -------------------------------------------
# Razorpay (Client-side / Vite)
# -------------------------------------------
# The Razorpay Key ID exposed to the frontend via Vite (must be prefixed with VITE_).
# This is the same value as RAZORPAY_KEY_ID — it is safe to expose the key ID publicly.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# -------------------------------------------
# SMTP / Email (Nodemailer)
# -------------------------------------------
# SMTP configuration for sending order confirmation and newsletter emails.
# For Gmail, use an App Password (not your regular password).
# To create App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# -------------------------------------------
# Cloudinary (Image Hosting)
# -------------------------------------------
# Get these from your Cloudinary Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------
# Site URL (for email links)
# -------------------------------------------
# The base URL of your site (used in email templates for links).
# Development: http://localhost:3000
# Production: https://yourdomain.com
SITE_URL=http://localhost:3000

# -------------------------------------------
# CORS / Allowed origins
# -------------------------------------------
# Comma-separated origins that are allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,https://zarevielle.com

# -------------------------------------------
# Monitoring / Error tracking
# -------------------------------------------
# Optional Sentry DSN for backend exception tracking.
SENTRY_DSN=

# -------------------------------------------
# Instagram (optional)
# -------------------------------------------
# Instagram Basic Display API access token for feed integration.
# Get this from Facebook Developer Console.
# If not set, placeholder images will be shown.
INSTAGRAM_ACCESS_TOKEN=
